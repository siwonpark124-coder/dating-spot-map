# Supabase (프로젝트 설정 > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 아래 두 개는 scripts/fetch-places.mjs 전용 (서버/로컬 스크립트에서만 사용, 절대 NEXT_PUBLIC_ 붙이지 말 것 — 브라우저에 노출되면 안 되는 비밀 값)
# 카카오 개발자 콘솔 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# Supabase 프로젝트 설정 > API > service_role 키 (RLS를 우회해서 insert 가능한 관리자 키)
SUPABASE_SERVICE_ROLE_KEY=

# /review 검수 페이지 비밀번호 (아무 문자열이나 직접 정해서 넣으면 됨)
REVIEW_PASSWORD=

# 코스 구간을 실제 보행로로 그리기 위한 OpenRouteService 키.
# openrouteservice.org 가입하면 대시보드 상단에 basic key가 바로 나온다 (카드 불필요, 하루 2,000회).
# 없어도 앱은 동작하지만 코스가 직선 점선으로 그려지고 도보 시간이 추정치가 된다.
ORS_API_KEY=
